<Window x:Class="StreamDisplayAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamDisplay Assistant"
        Height="720" Width="960"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19" />
        <SolidColorBrush x:Key="CardBg" Color="#111827" />
        <SolidColorBrush x:Key="CardBorder" Color="#1F2937" />
        <SolidColorBrush x:Key="CardHover" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentGold" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <!-- Button Style Modern -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Outline Button -->
        <Style x:Key="ModernOutlineBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>

        <!-- Primary Blue Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"/>

        <!-- Accent Gold Button (Pro) -->
        <Style x:Key="GoldBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Red Button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Margin="0,0,16,0"
                                Padding="{TemplateBinding Padding}"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Modern ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chevron Arrow -->
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#94A3B8"
                          StrokeThickness="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#334155"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#38BDF8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Toggle Button Background -->
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <!-- Display Selected Content -->
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!-- Popup Dropdown -->
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#0F172A"
                                            BorderThickness="1"
                                            BorderBrush="#334155"
                                            CornerRadius="8"
                                            Margin="0,4,0,8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#0E131F" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0" BorderBrush="#38BDF8" BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="StreamDisplay Assistant" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border x:Name="LicenseBadge"
                                    Background="#334155"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLicenseBadge"
                                           Text="FREE EDITION"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Resolution, HDR &amp; OLED Anti-Burn-in Automation for Sunshine &amp; Moonlight"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛡️ OLED Blackout"
                            Style="{StaticResource DangerBtn}"
                            Click="QuickOledBlackout_Click"
                            ToolTip="Instantly drop a pure black shield over the host display to prevent OLED burn-in"
                            Margin="0,0,10,0"/>
                    <Button Content="📥 Minimize to Tray"
                            Style="{StaticResource ModernBtn}"
                            Click="MinimizeToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA WITH TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="24,16,24,10">

            <!-- TAB 1: QUICK CONTROL (FREE) -->
            <TabItem Header="🖥️ Quick Control">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">

                        <!-- CARD 1: CURRENT DISPLAY STATUS -->
                        <Border Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Active Primary Display" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Real-time hardware status detected via Windows P/Invoke" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,12,8">
                                            <StackPanel>
                                                <TextBlock Text="RESOLUTION &amp; REFRESH RATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtCurrentResolution" Text="Detecting..." FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,12,8">
                                            <StackPanel>
                                                <TextBlock Text="WINDOWS HDR STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtCurrentHdr" Text="Checking..." FontSize="16" FontWeight="SemiBold" Foreground="#10B981" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,12,8">
                                            <StackPanel>
                                                <TextBlock Text="SAVED NATIVE PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtNativeSaved" Text="N/A" FontSize="16" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="🔄 Refresh Status" Style="{StaticResource ModernBtn}" Click="BtnRefreshDisplayStatus_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CARD 2: QUICK RESOLUTION SWITCHER -->
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Quick Streaming Resolution Switcher" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <TextBlock Text="Instantly match your PC display resolution to your client handheld, tablet, or TV aspect ratio" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CmbDisplayProfiles" Grid.Column="0" Margin="0,0,12,0"/>

                                    <Button Grid.Column="1"
                                            Content="⚡ Apply Resolution"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="BtnApplyProfile_Click"
                                            Margin="0,0,8,0"/>

                                    <Button Grid.Column="2"
                                            Content="↩️ Restore Native"
                                            Style="{StaticResource ModernBtn}"
                                            Click="BtnRestoreNative_Click"/>
                                </Grid>

                                <!-- Hardware Detected Modes -->
                                <TextBlock Text="🖥️ Monitor Hardware Native Modes (Direct Physical Support):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CmbHardwareModes" Grid.Column="0" Margin="0,0,12,0"/>

                                    <Button Grid.Column="1"
                                            Content="🚀 Apply Hardware Mode"
                                            Style="{StaticResource ModernBtn}"
                                            Click="BtnApplyHardwareMode_Click"/>
                                </Grid>

                                <Separator Background="#1F2937" Margin="0,4,0,14"/>

                                <!-- Custom Resolution Manual Input -->
                                <TextBlock Text="🛠️ Custom Resolution (Manual Input):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Width Input -->
                                    <TextBox x:Name="TxtCustomWidth"
                                             Grid.Column="0"
                                             Text="2048"
                                             ToolTip="Width in pixels (e.g. 2048, 1920, 1600)"
                                             Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="1" Text="×" FontSize="16" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <!-- Height Input -->
                                    <TextBox x:Name="TxtCustomHeight"
                                             Grid.Column="2"
                                             Text="1536"
                                             ToolTip="Height in pixels (e.g. 1536, 1200, 1080)"
                                             Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="3" Text="@" FontSize="15" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <!-- Refresh Rate Input -->
                                    <TextBox x:Name="TxtCustomHz"
                                             Grid.Column="4"
                                             Text="Auto"
                                             ToolTip="Refresh rate (e.g. 60, 120, or Auto for best supported frequency)"
                                             Margin="0,0,12,0"/>

                                    <!-- Apply Custom Button -->
                                    <Button Grid.Column="5"
                                            Content="🎯 Apply Custom"
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="BtnApplyCustom_Click"
                                            Margin="0,0,8,0"/>

                                    <!-- Save to Presets Button -->
                                    <Button Grid.Column="6"
                                            Content="💾 Save to List"
                                            Style="{StaticResource ModernBtn}"
                                            Click="BtnSaveCustomProfile_Click"
                                            ToolTip="Permanently save this custom resolution into your presets list"/>
                                </Grid>

                                <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,6,0,0" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✨" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Zero-Touch Aspect Matching: When selecting iPad (4:3) or Steam Deck (16:10), if your physical monitor doesn't support an exact tablet resolution (like 2048x1536 on a 1440p monitor), the engine automatically selects your screen's highest supported native 4:3 mode (1920x1440) for 100% full-screen streaming with zero black bars!"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: HDR AND BLACKOUT CONTROLS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- HDR Card -->
                            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,16">
                                <StackPanel>
                                    <TextBlock Text="🌈 Windows HDR Switch" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Quickly turn High Dynamic Range on or off with a single click without digging into Windows settings" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Turn HDR ON" Style="{StaticResource ModernBtn}" Click="BtnHdrOn_Click" Margin="0,0,8,0"/>
                                        <Button Content="Turn HDR OFF" Style="{StaticResource ModernBtn}" Click="BtnHdrOff_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- OLED Burn-in Protection Card -->
                            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🛡️ OLED Burn-in Shield" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Creates an uncompressed #000000 pure black fullscreen shield on your host monitor, physically powering off OLED pixels while you play" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                                    <Button Content="🛡️ Launch OLED Blackout (ESC to exit)"
