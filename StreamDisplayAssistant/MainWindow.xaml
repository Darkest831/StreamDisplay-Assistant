                                <TextBlock Text="🚀 Quick Start: 3 Simple Steps to Stream" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Step 1: Choose Your Streaming Software" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="In the '👑 Zero-Touch Automation' tab, make sure your streaming host is selected. You can pick '🌟 Any Streaming App' (recommended), '☀️ Sunshine', '🎮 Steam Remote Play', or '⚡ Parsec'. Our multi-drive scanner automatically finds your installed apps on C:, D:, E:, etc."
                                                   FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Step 2: Keep 'Auto-Detect from Client' Selected" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Under 'Streaming Resolution to Apply', leave the dropdown on '✨ Auto-Detect from Client'. When your device connects (e.g. iPad Air M2 requesting 2360x1640), our smart resolution engine instantly calculates the highest native resolution matching that aspect ratio (e.g. 1920x1440 @ 180Hz) to eliminate black bars with crystal-clear text."
                                                   FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E293B" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Step 3: Click 'TURN ON BACKGROUND AUTOMATION' (PRO)" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Click the big toggle button at the top of the Automation tab. That's it! You can now minimize the app to your system tray. Whenever you start streaming from your client device, resolution changes, speaker muting, and OLED blackout trigger automatically, and restore your native desktop when you disconnect."
                                                   FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: IPAD & STEAM DECK OPTIMIZATION -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📱 Device Optimization: iPad Air M2, Steam Deck &amp; Handhelds" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,12"/>

                                <TextBlock Text="• iPad Air M2 / iPad Pro 11-inch (2360x1640):" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="iPads use a ~4.3:3 / 1.439 aspect ratio. Standard PC monitors only support 16:9 (1440p) natively, which usually causes huge letterboxing black bars. Our Auto-Adapt engine applies the monitor's highest 4:3 raster mode (1920x1440 @ 180Hz). Moonlight stretches this cleanly to fill the entire iPad screen edge-to-edge without any blurriness or zoom distortion!"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="• Steam Deck &amp; ROG Ally (1280x800 / 16:10):" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="The Steam Deck screen is 16:10. When connected via Moonlight or Steam Remote Play, StreamDisplay Assistant auto-applies 1920x1200 @ 180Hz (or 1280x800), giving you pixel-perfect edge-to-edge gameplay with zero black bars."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="• Phones &amp; Laptops (16:9 / 20:9):" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Standard 16:9 devices automatically trigger your highest refresh rate 1440p (2560x1440 @ 180Hz) or 1080p mode."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: OLED BLACKOUT & HDR -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🖤 Multi-Monitor OLED Blackout &amp; HDR Anti-Burn-In Protection" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,12"/>

                                <TextBlock Text="• How OLED Blackout Works:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="When remote streaming from another room, your PC monitor normally stays brightly lit, displaying desktop HUDs or static game windows that cause burn-in on OLED panels (LG C2/C3/C4, Alienware QD-OLED, Samsung Odyssey OLED, ASUS ROG OLED). Our OLED Shield creates a pure #000000 black fullscreen layer across all physical monitors. On OLED panels, true black pixels are physically powered off (0 nits), completely protecting your screens while cutting power consumption to idle levels!"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="• Automatic HDR Switching:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Windows HDR is enabled automatically via Windows DisplayConfig APIs when you stream (essential for Moonlight HDR on iPad OLED / Steam Deck OLED), and turned back off automatically when you finish."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: NVIDIA & AMD CUSTOM RESOLUTIONS -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🎨 Driver-Level Custom Resolutions (NVIDIA &amp; AMD)" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <TextBlock Text="• How Custom Resolutions Work in StreamDisplay Assistant:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="StreamDisplay Assistant uses 100% native Windows Display APIs (EnumDisplaySettingsEx / ChangeDisplaySettingsEx). It instantly discovers and supports any custom resolution registered in your GPU driver."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="• Adding Exact 1:1 iPad Resolution in NVIDIA Control Panel (Optional):" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="1. Right-click your desktop -> Open 'NVIDIA Control Panel'&#x0a;2. Navigate to 'Display' -> 'Change resolution' -> Click 'Customize...'&#x0a;3. Click 'Create Custom Resolution'&#x0a;4. Enter Horizontal pixels: 2360, Vertical lines: 1640, Refresh rate: 60Hz (or 120Hz)&#x0a;5. Click 'Test' and then 'Yes' to save.&#x0a;As soon as you save it, StreamDisplay Assistant auto-detects it in real-time and will apply exact 2360x1640 with 100% priority whenever your iPad connects!"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="• Zero Third-Party Drivers / 100% Safe &amp; Anti-Cheat Compliant:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="StreamDisplay Assistant does NOT install third-party virtual display drivers or modify kernel binaries. This guarantees 100% Windows WHQL compatibility, prevents bluescreens (BSOD), and keeps competitive games with Kernel Anti-Cheat (Valorant Vanguard, EasyAntiCheat, BattlEye) completely safe from bans."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 5: FAQ & TROUBLESHOOTING -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="❓ Frequently Asked Questions (FAQ)" FontSize="16" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,12"/>

                                <TextBlock Text="Q: Why was my screen resolution zoomed in before?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="A: The older fallback engine selected 720x480 (a legacy NTSC mode). Our upgraded Quality-Weighted scoring engine guarantees that high-resolution client targets always map to high-resolution raster modes (e.g. 1920x1440 @ 180Hz) so text and HUDs are never zoomed or blurry."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Q: Does host speaker muting work automatically?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="A: Yes! When 'Auto-mute host PC speakers' is checked, StreamDisplay Assistant mutes the Windows master audio endpoint during streaming so sound doesn't blast in your room, and restores your original volume the instant you disconnect."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Q: Do I need to keep this window open while playing?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="A: No! You can minimize StreamDisplay Assistant to the Windows System Tray (next to your system clock). It uses ~0.0% CPU and zero memory overhead while quietly listening for connections."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Q: How do I exit OLED Blackout manually if needed?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="A: Press the 'ESC' key, 'Spacebar', double-click anywhere on the black screen, or press the global hotkey 'Ctrl + Shift + F11'."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#090D16" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="20,10">
